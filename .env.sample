# Required: BlazeSQL API key.
BLAZE_API_KEY=YOUR_API_KEY_HERE

# Optional: override the BlazeSQL endpoint.
# Use HTTPS for remote endpoints. Plain HTTP is rejected unless it targets localhost
# or BLAZE_ALLOW_INSECURE_ENDPOINT=true is set explicitly.
# BLAZE_API_ENDPOINT=https://api.blazesql.com/natural_language_query_api

# Optional: request timeout in milliseconds.
# BLAZE_REQUEST_TIMEOUT_MS=15000

# Optional: cap formatted MCP/CLI output.
# BLAZE_MAX_RESPONSE_CHARS=20000

# Optional: one of error, info, debug.
# BLAZE_LOG_LEVEL=error

# Optional: allow non-HTTPS endpoints for local testing only.
# BLAZE_ALLOW_INSECURE_ENDPOINT=false
